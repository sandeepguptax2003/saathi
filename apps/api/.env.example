# Saathi API configuration. Copy to .env for local dev. NEVER commit real values.
# The app validates these at boot and refuses to start when a required one is missing.

# --- runtime
ENV=local
LOG_LEVEL=INFO
PORT=8000
RELEASE=

# --- LLM: Nebius Token Factory (OpenAI compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
# true = offline deterministic backend (tests, CI, e2e); must be false in production
LLM_MOCK=false
LLM_TIMEOUT_S=20

# --- database (Supabase pooler in prod; docker-compose Postgres locally)
DATABASE_URL=
# Optional: fills a literal [YOUR-PASSWORD] in DATABASE_URL (paste Supabase's string as-is)
DATABASE_PASSWORD=
# true when DATABASE_URL is the Supabase transaction pooler (disables prepared statements)
DB_PGBOUNCER=false
DB_ENFORCE_RLS=false

# --- auth (Supabase)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- encryption (>= 32 chars). Rotate: bump ENCRYPTION_KEY_VERSION, move the old pepper into
#     ENCRYPTION_LEGACY_PEPPERS as JSON, e.g. {"1": "<old pepper>"}
ENCRYPTION_PEPPER=
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_LEGACY_PEPPERS={}

# --- budget (USD per day)
DAILY_BUDGET_USD=1.0
GLOBAL_DAILY_BUDGET_USD=2.0

# --- HTTP: comma-separated allowlist
CORS_ORIGINS=http://localhost:3000

# --- observability
SENTRY_DSN=
