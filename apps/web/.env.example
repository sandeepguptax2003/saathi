# Public, browser-safe values only. Never put secrets (service role key, API keys) here.
# Base URL of the Saathi API (no trailing slash), e.g. http://localhost:8000 locally.
NEXT_PUBLIC_API_URL=
# Supabase project URL and anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Sentry DSN for browser error reporting.
NEXT_PUBLIC_SENTRY_DSN=
