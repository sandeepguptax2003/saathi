# Non-secret defaults for the local api container (infra/docker-compose.yml).
# Real values go in apps/api/.env (git-ignored), which overrides this file.
ENV=local
LOG_LEVEL=debug
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
SUPABASE_URL=http://localhost:54321
# Placeholder values: local only, never reuse anywhere else.
SUPABASE_JWT_SECRET=local-dev-only-not-a-secret
ENCRYPTION_PEPPER=local-dev-only-not-a-secret
DAILY_BUDGET_USD=1
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=
