# Saathi — root env template.
# Each app owns its real env template; copy those, not this file:
#   cp apps/api/.env.example apps/api/.env      # NEBIUS_API_KEY, DATABASE_URL, SUPABASE_*, ENCRYPTION_PEPPER, ...
#   cp apps/web/.env.example apps/web/.env.local # NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SUPABASE_*, ...
#
# Variables below are only read by infra/docker-compose.yml and the Makefile (local dev).
# They are local-only defaults, never production credentials.
# Usage: cp .env.example .env   (optional; defaults apply without it)

# Local Postgres (pgvector/pgvector:pg16) exposed on the host
DB_PORT=5432
API_PORT=8000
WEB_PORT=3000

# Base URL used by `make types` to fetch openapi.json
API_URL=http://localhost:8000
